# Copy this file to .env and fill it in. See SETUP.md for where each value comes from.

# Your Tailscale Funnel address (no trailing slash). Players use this, and Discord redirects back to it.
# Leave as localhost while testing on this PC only.
PUBLIC_URL=http://localhost:3000

# From https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord user IDs (comma-separated) that get admin tools. In Discord: Settings -> Advanced ->
# Developer Mode, then right-click your name -> Copy User ID.
ADMIN_DISCORD_IDS=

# Optional
# PORT=3000            (if you change this, also change 3000 in start.bat)
# SESSION_DAYS=30      (how long players stay signed in)
# KEEP_AWAKE=true      (stop Windows sleeping while the server runs)
