# Copy this file to .env and fill it in. See SETUP.md for where each value comes from.

# Where you open the dashboard (no trailing slash). Discord redirects back here after login.
PUBLIC_URL=http://localhost:3100

# One Discord application for everything: your dashboard login, the bot, and players signing in to
# your games (LucidHub passes these to each game). Developer portal -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Developer portal -> your app -> Bot -> Reset Token. Lets the hub DM prizes and post announcements.
DISCORD_BOT_TOKEN=

# Discord user IDs (comma-separated) allowed into the dashboard and /hub. In Discord: Settings ->
# Advanced -> Developer Mode, then right-click your name -> Copy User ID.
ADMIN_DISCORD_IDS=

# Optional
# PORT=3100            (if you change this, also change PUBLIC_URL and each game's HUB_URL)
# SESSION_DAYS=30      (how long you stay signed in to the dashboard)
# KEEP_AWAKE=true      (stop Windows sleeping while the hub runs)
